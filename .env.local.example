# ── İstemci (public) Firebase config ──
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ── Sunucu (GİZLİ — NEXT_PUBLIC değil!) ──
# Kod tabanlı e-posta doğrulama için gereklidir.
# Firebase Admin (Service Account: Firebase Console → Project settings → Service accounts → Generate new private key)
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxx@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX...\n-----END PRIVATE KEY-----\n"

# Gmail ile e-posta gönderimi (Brevo vb. gerekmez)
# Google Hesabı → Güvenlik → 2 Adımlı Doğrulama AÇIK olmalı → "Uygulama Şifreleri"nden 16 haneli şifre üret
GMAIL_USER=senin_adresin@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
